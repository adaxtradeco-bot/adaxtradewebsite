// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  password  String
  role      String   @default("admin") // admin, editor, viewer
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  bio       String?
  avatar    String?
  posts     Post[]
}

model Page {
  id            String    @id @default(cuid())
  title         String
  slug          String    @unique
  metaTitle     String?
  metaDescription String?
  status        String    @default("draft") // published, draft
  language      String    @default("en") // en, ar
  sections      String?   // JSON string of sections (legacy)
  builderData   String?   // JSON array of builder section configurations
  isBuilderPage Boolean   @default(false) // Flag for builder-created pages
  builderVersion String?  // Track builder version for migrations
  isHomepage    Boolean   @default(false) // Flag for homepage
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Translation {
  id        String   @id @default(cuid())
  key       String
  language  String   // en, ar
  value     String
  namespace String?  // components, pages, nav, etc.
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([key, language, namespace])
}

model Media {
  id        String   @id @default(cuid())
  filename  String
  path      String
  altText   String?
  fileSize  Int
  mimeType  String
  createdAt DateTime @default(now())
}

model SectionTemplate {
  id           String   @id @default(cuid())
  name         String
  type         String   // hero, features, cta, etc.
  category     String   // Headers, Content, Actions, etc.
  description  String
  defaultData  String   // JSON string
  usageCount   Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Menu {
  id        String   @id @default(cuid())
  name      String   // Main Menu, Footer Menu, etc.
  location  String   // header, footer, sidebar
  language  String   @default("en")
  items     String   // JSON array of menu items
  status    String   @default("active") // active, inactive
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([location, language])
}

model SiteSettings {
  id        String   @id @default(cuid())
  data      String   // JSON string of all settings
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Post {
  id              String        @id @default(cuid())
  slug            String
  language        String        @default("en")
  title           String
  excerpt         String?
  coverImage      String?
  coverImageAlt   String?
  builderData     String?       // JSON array of builder sections (same as Page.builderData)
  status          String        @default("draft") // draft | scheduled | published | archived
  publishedAt     DateTime?
  scheduledAt     DateTime?
  readingTime     Int           @default(1)
  metaTitle       String?
  metaDescription String?
  ogImage         String?
  canonicalUrl    String?
  noindex         Boolean       @default(false)
  source          String        @default("admin") // admin | api
  externalId      String?
  authorId        String?
  categoryId      String?
  postGroupId     String?
  author          User?         @relation(fields: [authorId], references: [id], onDelete: SetNull)
  category        BlogCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  postGroup       PostGroup?    @relation(fields: [postGroupId], references: [id], onDelete: SetNull)
  tags            BlogTag[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@unique([language, slug])
  @@unique([language, externalId])
  @@index([status, publishedAt])
  @@index([categoryId])
  @@index([postGroupId])
}

model PostGroup {
  id              String   @id @default(cuid())
  defaultLanguage String   @default("en")
  posts           Post[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model BlogCategory {
  id          String  @id @default(cuid())
  name        String
  slug        String
  description String?
  language    String
  groupKey    String? // same value across languages = same category
  posts       Post[]

  @@unique([language, slug])
  @@index([groupKey])
}

model BlogTag {
  id       String @id @default(cuid())
  name     String
  slug     String
  language String
  posts    Post[]

  @@unique([language, slug])
}

model ApiKey {
  id          String    @id @default(cuid())
  name        String
  prefix      String    @unique // first 8 chars, shown in the admin
  hashedKey   String    // sha256 of the full key
  scopes      String    @default("blog:write") // comma separated
  lastUsedAt  DateTime?
  revokedAt   DateTime?
  createdById String?
  createdAt   DateTime  @default(now())
}
