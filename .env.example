# Database - Choose one option:

# Option 1: Vercel Postgres (recommended)
POSTGRES_PRISMA_URL="postgresql://..."
POSTGRES_URL_NON_POOLING="postgresql://..."

# Option 2: Supabase / Neon / Other PostgreSQL
# DATABASE_URL="postgresql://..."

# File Storage
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."

# Authentication
# Required. At least 32 characters (e.g. `openssl rand -base64 48`). The app refuses to sign in without it.
JWT_SECRET="generate-a-random-secret-of-at-least-32-characters"
NEXTAUTH_SECRET="your-nextauth-secret-key"
NEXTAUTH_URL="https://your-domain.com"

# Admin Credentials
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-this-password"

# Environment
NODE_ENV="production"

# Resend (Contact Form Section emails)
RESEND_API_KEY="re_..."
CONTACT_FORM_FROM_EMAIL="onboarding@resend.dev"

# Brand / site identity (used for page titles, SEO, default copy; admin Site Settings take precedence where available)
NEXT_PUBLIC_SITE_NAME="Your Company"
NEXT_PUBLIC_SITE_SHORT_NAME="Your Company"
NEXT_PUBLIC_SITE_URL="https://yourdomain.com"
NEXT_PUBLIC_CONTACT_EMAIL="contact@yourdomain.com"
NEXT_PUBLIC_SITE_DESCRIPTION="Short description of your site"

# Contact forms only send to addresses configured in page-builder contact-form
# sections, to NEXT_PUBLIC_CONTACT_EMAIL, or to this comma-separated allowlist.
CONTACT_FORM_ALLOWED_RECIPIENTS=""

# Build-time database migration (scripts/migrate.js)
# SKIP_DB_MIGRATE=1   build without touching the database
# ALLOW_DB_PUSH=1     allow a non-destructive `prisma db push` if migrate deploy fails
